    def refresh_disks(self):
        oldsrc=self.chosen(self.source); olddst=self.chosen(self.dest)
        self._mounts=get_mounts(); self.source.remove_all(); self.dest.remove_all()
        for m in self._mounts:
            self.source.append_text(m['display'])
            if m['writable']: self.dest.append_text(m['display'])
        self._dest_mounts=[m for m in self._mounts if m['writable']]
        srcidx=0
        if oldsrc:
            for i,m in enumerate(self._mounts):
                if m['path']==oldsrc: srcidx=i; break
        self.source.set_active(srcidx if self._mounts else -1)
        dstidx=-1
        if olddst:
            for i,m in enumerate(self._dest_mounts):
                if m['path']==olddst: dstidx=i; break
        if dstidx<0:
            for i,m in enumerate(self._dest_mounts):
                if m['path']!='/': dstidx=i; break
        self.dest.set_active(dstidx if dstidx>=0 else (0 if self._dest_mounts else -1))
        self.update_source_info(); self.update_dest_info()

    def chosen(self,combo):
        try:
