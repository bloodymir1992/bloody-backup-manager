    def calculate_dir_sizes(self,dirs,generation):
        total=len(dirs)
        for idx,raw in enumerate(dirs,1):
            if generation!=getattr(self,'_scan_generation',generation):
                GLib.idle_add(self.finish_size_calculation,generation,True)
                return
            p=Path(raw)
            s=dir_size(p,True)
            self.set_cached_size(p,s)
            GLib.idle_add(self.update_row_size,raw,s,generation,idx,total)
        save_size_cache(self.size_cache)
        GLib.idle_add(self.finish_size_calculation,generation,False)

    def update_row_size(self,raw,size,generation,idx=None,total=None):
