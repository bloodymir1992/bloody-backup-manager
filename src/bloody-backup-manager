    def navigate(self,p):
        p=Path(p).resolve()
        if p==Path(self.current_path).resolve():return
        self.history.append(Path(self.current_path)); self.scan_path(p,False,push=False)

    def scan_path(self,base,one_fs=False,push=False):
        base=Path(base)
        self.current_path=base
        self.path_entry.set_text(str(base))
        self.back_btn.set_sensitive(bool(self.history))
        try:self.up_btn.set_sensitive(base.resolve()!=self.source_root())
        except Exception:self.up_btn.set_sensitive(False)
        self.status.set_text(f'Cargando contenido de {base}...')
        self.backup_btn.set_sensitive(False); self.move_btn.set_sensitive(False); self.size_btn.set_sensitive(False)
        show_hidden=self.hidden.get_active()
        self._scan_generation=getattr(self,'_scan_generation',0)+1
        generation=self._scan_generation
        def work():
            rows=[]
            dirs=[]
            try: entries=list(base.iterdir())
            except Exception as e: GLib.idle_add(self.finish_scan,[],str(e),generation,[]); return
            skip={'proc','sys','dev','run'} if str(base)=='/' else set()
            for p in entries:
                if p.name in skip or (not show_hidden and p.name.startswith('.')):continue
                try:
                    if p.is_symlink():continue
                    st=p.stat()
                    isdir=p.is_dir()
                    typ='Carpeta' if isdir else 'Archivo'
                    if isdir:
                        cached=self.get_cached_size(p,st)
                        if cached is None:
                            s=0; sizetxt='—'
                        else:
                            s=cached; sizetxt=fmt(cached)
                        dirs.append(str(p))
                    else:
                        s=st.st_size; sizetxt=fmt(s)
                    mt=datetime.datetime.fromtimestamp(st.st_mtime).strftime('%Y-%m-%d %H:%M')
                    icon_name=themed_icon_name(p,isdir)
                    rows.append((False,typ,p.name,str(p),sizetxt,s,mt,icon_name,None))
                except Exception:pass
            rows.sort(key=lambda r:(0 if r[1]=='Carpeta' else 1,r[2].lower()))
            GLib.idle_add(self.finish_scan,rows,None,generation,dirs)
        threading.Thread(target=work,daemon=True).start()

    def finish_scan(self,rows,error,generation=None,dirs=None):
        if generation is not None and generation!=getattr(self,'_scan_generation',generation): return False
        self.store.clear()
        for r in rows:self.store.append(r)
        self.status.set_text(('Error: '+error) if error else f'{len(rows)} elemento(s) en {self.current_path}')
        self.backup_btn.set_sensitive(True); self.move_btn.set_sensitive(True)
        self.size_btn.set_sensitive(True)
        self.path_entry.set_text(str(self.current_path)); self.back_btn.set_sensitive(bool(self.history)); self.update_count(); self.update_source_info()
        if not error:
            image_paths=[r[3] for r in rows if Path(r[3]).suffix.lower() in IMAGE_EXTS and r[1]=='Archivo']
            if image_paths:
                self._thumb_queue=list(image_paths)
