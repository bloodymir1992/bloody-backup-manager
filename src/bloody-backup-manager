        if thumb is not None:
            self.update_row_thumbnail(raw,thumb,generation)
        if generation==getattr(self,'_scan_generation',generation):
            self.status.set_text(f'{len(self.store)} elemento(s) en {self.current_path} • miniaturas {self._thumb_done}/{getattr(self,"_thumb_total",self._thumb_done)}')
        return bool(queue)

