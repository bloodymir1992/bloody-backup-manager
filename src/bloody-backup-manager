    def backup_and_free(self,_):
        items=self.selected_items()
        if not items:self.dialog('Selecciona al menos una carpeta o archivo.');return
        base=self.chosen(self.dest)
        if not base:self.dialog('No hay un destino disponible.');return
        critical={Path('/'),Path('/home'),Path('/usr'),Path('/var'),Path('/etc'),Path('/boot'),Path('/opt'),Path('/root'),Path('/bin'),Path('/sbin'),Path('/lib'),Path('/lib64')}
        source_root=self.source_root(); blocked=[]
        for src in items:
            try:rp=src.resolve()
            except Exception:rp=src
            if rp in critical or rp==source_root:blocked.append(str(src))
        if blocked:
            self.dialog('Por seguridad no se puede liberar espacio eliminando raíces o carpetas críticas:\n\n'+'\n'.join(blocked[:8]));return
        machine=(self.machine.get_text().strip() or socket.gethostname()).replace('/','-')
        target=(Path(base)/'Bloody Backup'/f'{machine} Backup').resolve(); bad=[]
        for src in items:
            try:
                rp=src.resolve()
                if target==rp or target in rp.parents or rp in target.parents:bad.append(str(src))
            except Exception:pass
        if bad:
            self.dialog('El destino no puede estar dentro del origen ni el origen dentro del destino:\n\n'+'\n'.join(bad[:8]));return
        names='\n'.join(f'• {p.name}' for p in items[:12])
        if len(items)>12:names+=f'\n• … y {len(items)-12} más'
        d=Gtk.MessageDialog(self,0,Gtk.MessageType.WARNING,Gtk.ButtonsType.NONE,APP)
        d.set_markup('<b>¿Respaldar y eliminar los originales?</b>')
        d.format_secondary_text('Primero se copiarán y verificarán. Solo los elementos verificados correctamente se eliminarán del origen.\n\n'+names)
        d.add_button('Cancelar',Gtk.ResponseType.CANCEL); d.add_button('Respaldar y liberar',Gtk.ResponseType.OK)
        response=d.run(); d.destroy()
        if response==Gtk.ResponseType.OK:self.start_backup(delete_after=True)

    def start_backup(self,delete_after=False):
        base=self.chosen(self.dest)
        if not base:self.dialog('No hay un destino disponible.');return
        items=self.selected_items()
        if not items:self.dialog('Selecciona al menos una carpeta o archivo.');return
        machine=(self.machine.get_text().strip() or socket.gethostname()).replace('/','-')
        target=Path(base)/'Bloody Backup'/f'{machine} Backup'; target.mkdir(parents=True,exist_ok=True)
        self.backup_btn.set_sensitive(False); self.move_btn.set_sensitive(False); self.progress.set_fraction(0)
        self.status.set_text('Respaldando y verificando...' if delete_after else 'Respaldando...')
        verify=self.verify.get_active()
        def work():
            errors=[];deleted=[]
            for idx,src in enumerate(items,1):
                dest=target/src.name
                try:
                    if src.is_dir():
                        dest.mkdir(parents=True,exist_ok=True); cmd=['rsync','-a','--human-readable','--info=progress2',str(src)+'/',str(dest)+'/']
                    else:cmd=['rsync','-a','--human-readable','--info=progress2',str(src),str(dest)]
                    p=subprocess.run(cmd,capture_output=True,text=True)
                    if p.returncode!=0:errors.append(f'{src.name}: rsync falló: {p.stderr.strip()[-200:]}')
                    else:
                        good=True; verify_msg='verificación desactivada'
                        if verify or delete_after:
                            GLib.idle_add(self.status.set_text,f'Verificando contenido SHA-256: {src.name}...')
                            good,verify_msg=verify_content(src,dest)
                        if not good:
                            errors.append(f'{src.name}: verificación falló ({verify_msg}); original conservado')
                        elif delete_after:
                            if src.is_dir():shutil.rmtree(src)
                            else:src.unlink()
                            deleted.append(src.name)
                except Exception as e:errors.append(f'{src.name}: {e}')
                GLib.idle_add(self.progress.set_fraction,idx/len(items))
            GLib.idle_add(self.finish_backup,target,errors,deleted,delete_after)
        threading.Thread(target=work,daemon=True).start()

    def finish_backup(self,target,errors,deleted,delete_after):
        self.backup_btn.set_sensitive(True);self.move_btn.set_sensitive(True)
        if errors:
            self.status.set_text('Operación terminó con avisos.'); extra=(f'\n\nEliminados del origen: {len(deleted)}.' if delete_after else ''); self.dialog('\n'.join(errors[:10])+extra)
        else:
            if delete_after:
                self.status.set_text(f'Respaldo verificado y originales eliminados: {target}'); self.dialog(f'Respaldo completado y verificado.\nSe liberó espacio eliminando {len(deleted)} elemento(s) del origen.\n\n{target}'); self.reload_current()
            else:
                self.status.set_text(f'Respaldo completo: {target}'); self.dialog(f'Respaldo completado y verificado.\n\n{target}')
        self.update_source_info();self.update_dest_info();return False

