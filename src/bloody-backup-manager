    def get_cached_size(self,p,st=None):
        try:
            p=Path(p)
            if st is None:
                st=p.stat()
            key=str(p.resolve())
            item=self.size_cache.get(key)
            if not isinstance(item,dict):
                return None
            if int(item.get('mtime_ns',-1)) != int(st.st_mtime_ns):
                return None
            size=int(item.get('size',-1))
            return size if size>=0 else None
        except Exception:
            return None

    def set_cached_size(self,p,size):
        try:
            p=Path(p)
            st=p.stat()
            self.size_cache[str(p.resolve())]={'size':int(size),'mtime_ns':int(st.st_mtime_ns)}
        except Exception:
