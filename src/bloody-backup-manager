def fmt(n):
    n=float(n)
    for u in ['B','KB','MB','GB','TB']:
        if n < 1024 or u=='TB': return f'{n:.1f} {u}'
        n/=1024

def dir_size(path, one_fs=False):
    try:
        cmd=['du','-sb']
        if one_fs: cmd.insert(1,'-x')
        p=subprocess.run(cmd+[str(path)],capture_output=True,text=True,timeout=240)
        return int(p.stdout.split()[0]) if p.returncode==0 and p.stdout else 0
    except Exception:
        return 0

def usage(path):
    try:
        u=shutil.disk_usage(path)
        return u.total,u.used,u.free
    except Exception:
        return 0,0,0

def sha256_file(path, chunk_size=8*1024*1024):
    h=hashlib.sha256()
    with open(path,'rb') as f:
        while True:
            chunk=f.read(chunk_size)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()

def content_manifest(path):
    """Return a content manifest suitable for destructive-backup verification.

    The manifest compares directory layout, regular-file sizes and SHA-256
    hashes, and symbolic-link targets. Metadata such as owner and mtime is not
    used to decide whether user data may be deleted from the source.
    """
    root=Path(path)
    if root.is_symlink():
        return [('L','.',os.readlink(root))]
    if root.is_file():
        st=root.stat()
        return [('F','.',st.st_size,sha256_file(root))]
    if not root.is_dir():
        st=root.lstat()
        return [('O','.',st.st_mode,st.st_size)]

    manifest=[]
    for current,dirnames,filenames in os.walk(root,topdown=True,followlinks=False):
        current=Path(current)
        rel_dir=current.relative_to(root)
        rel_dir_text='.' if str(rel_dir)=='.' else rel_dir.as_posix()
        manifest.append(('D',rel_dir_text))
        keep_dirs=[]
        for name in sorted(dirnames):
            child=current/name
            rel=child.relative_to(root).as_posix()
            if child.is_symlink():
                manifest.append(('L',rel,os.readlink(child)))
            else:
                keep_dirs.append(name)
        dirnames[:]=keep_dirs
        for name in sorted(filenames):
            child=current/name
            rel=child.relative_to(root).as_posix()
            if child.is_symlink():
                manifest.append(('L',rel,os.readlink(child)))
                continue
            st=child.stat()
            if child.is_file():
                manifest.append(('F',rel,st.st_size,sha256_file(child)))
            else:
                manifest.append(('O',rel,st.st_mode,st.st_size))
    manifest.sort(key=repr)
    return manifest

def verify_content(source,destination):
    try:
        src_manifest=content_manifest(source)
        dst_manifest=content_manifest(destination)
        if src_manifest==dst_manifest:
            return True,'SHA-256 y estructura coinciden'
        src_set=set(src_manifest); dst_set=set(dst_manifest)
        missing=list(src_set-dst_set)
        extra=list(dst_set-src_set)
        details=[]
        if missing:
            details.append(f'{len(missing)} elemento(s) diferentes o faltantes en destino')
        if extra:
            details.append(f'{len(extra)} elemento(s) extra/diferentes en destino')
        return False,', '.join(details) or 'los manifiestos no coinciden'
    except Exception as e:
        return False,f'no se pudo completar la verificación SHA-256: {e}'

IMAGE_EXTS={'.png','.jpg','.jpeg','.webp','.bmp','.gif','.tif','.tiff','.ico'}
VIDEO_EXTS={'.mp4','.mkv','.avi','.mov','.webm','.m4v','.wmv','.flv'}
AUDIO_EXTS={'.mp3','.flac','.wav','.ogg','.m4a','.aac','.opus'}
ARCHIVE_EXTS={'.zip','.rar','.7z','.tar','.gz','.bz2','.xz','.tgz','.tbz','.txz'}
DOC_EXTS={'.pdf','.odt','.doc','.docx','.rtf'}
SHEET_EXTS={'.ods','.xls','.xlsx','.csv'}
PRESENT_EXTS={'.odp','.ppt','.pptx'}
CODE_EXTS={'.py','.js','.ts','.cpp','.c','.h','.hpp','.java','.sh','.html','.css','.json','.yaml','.yml','.xml'}

def themed_icon_name(path,isdir):
    if isdir: return 'folder'
    ext=path.suffix.lower()
    name=path.name.lower()
    if ext in IMAGE_EXTS: return 'image-x-generic'
    if ext in VIDEO_EXTS: return 'video-x-generic'
    if ext in AUDIO_EXTS: return 'audio-x-generic'
    if ext=='.pdf': return 'application-pdf'
    if ext in ARCHIVE_EXTS or name.endswith('.tar.gz'): return 'package-x-generic'
    if ext=='.deb': return 'package-x-generic'
    if ext in SHEET_EXTS: return 'x-office-spreadsheet'
    if ext in PRESENT_EXTS: return 'x-office-presentation'
    if ext in DOC_EXTS: return 'x-office-document'
    if ext in CODE_EXTS: return 'text-x-script'
    try:
        if os.access(path,os.X_OK): return 'application-x-executable'
    except Exception: pass
    return 'text-x-generic'

def _scale_pixbuf(pb,size):
    if pb is None:
        return None
    try:
        w,h=pb.get_width(),pb.get_height()
        if w<=0 or h<=0:
            return None
        scale=min(size/w,size/h,1.0)
        nw=max(1,int(w*scale)); nh=max(1,int(h*scale))
        if nw==w and nh==h:
            return pb
        return pb.scale_simple(nw,nh,GdkPixbuf.InterpType.BILINEAR)
    except Exception:
        return pb

def make_thumbnail(path,size=56):
    p=Path(path)
    try:
        if p.suffix.lower() not in IMAGE_EXTS or not p.is_file():
            return None
        st=p.stat()
        if st.st_size > 100*1024*1024:
            return None
        try:
            pb=GdkPixbuf.Pixbuf.new_from_file(str(p))
            thumb=_scale_pixbuf(pb,size)
            if thumb is not None:
                return thumb
        except Exception:
            pass
        helper=shutil.which('gdk-pixbuf-thumbnailer')
        if helper:
            cache=HOME/'.cache'/'bloody-backup-manager'/'thumbnails'
            cache.mkdir(parents=True,exist_ok=True)
            key=hashlib.sha256(f'{p.resolve()}|{st.st_mtime_ns}|{st.st_size}'.encode()).hexdigest()
            out=cache/f'{key}.png'
            if not out.exists():
                r=subprocess.run([helper,'-s',str(max(size*2,128)),str(p),str(out)],
                                 stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=20)
                if r.returncode!=0:
                    try: out.unlink(missing_ok=True)
                    except Exception: pass
            if out.exists():
                try:
                    return _scale_pixbuf(GdkPixbuf.Pixbuf.new_from_file(str(out)),size)
                except Exception:
                    pass
    except Exception:
        pass
    return None

def load_size_cache():
    try:
        if not SIZE_CACHE_FILE.exists():
            return {}
        data=json.loads(SIZE_CACHE_FILE.read_text())
        return data if isinstance(data,dict) else {}
    except Exception:
        return {}

def save_size_cache(cache):
    try:
        CACHE_DIR.mkdir(parents=True,exist_ok=True)
        tmp=SIZE_CACHE_FILE.with_suffix('.tmp')
        tmp.write_text(json.dumps(cache,separators=(',',':')))
        tmp.replace(SIZE_CACHE_FILE)
    except Exception:
        pass

def get_mounts():
    out=[]
    try:
        p=subprocess.run(['lsblk','-J','-o','NAME,SIZE,FSTYPE,MOUNTPOINTS,LABEL,TYPE'],capture_output=True,text=True,check=True)
        data=json.loads(p.stdout)
        def walk(devs):
            for d in devs:
                for mp in (d.get('mountpoints') or []):
                    if not mp or not os.path.isdir(mp):
                        continue
                    fstype=(d.get('fstype') or '').lower()
                    if mp == '/boot/efi' or mp.startswith('/boot/efi/') or (mp.startswith('/boot') and fstype in {'vfat','fat','fat16','fat32'}):
                        continue
                    label=d.get('label') or ''
                    name=d.get('name') or ''
                    size=d.get('size') or ''
                    if mp=='/':
                        display=f'Sistema / SSD principal — {size} — /'
                    else:
                        display=f'{label or name} — {size} — {mp}'
                    if not any(x['path']==mp for x in out):
                        out.append({'path':mp,'label':label or name,'size':size,'display':display,'writable':os.access(mp,os.W_OK)})
                walk(d.get('children') or [])
        walk(data.get('blockdevices') or [])
    except Exception:
        pass
    out.sort(key=lambda x:(0 if x['path']=='/' else 1,x['display'].lower()))
    return out

